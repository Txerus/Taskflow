# Facultatif avant compilation : endpoint HTTPS servant latest.yml, .exe et .blockmap
TASKFLOW_UPDATE_URL=
# Signature : CSC_LINK / CSC_KEY_PASSWORD configurés dans les secrets CI, jamais dans git.

# Phase 3 — OAuth public client. Ne jamais committer de jeton utilisateur.
# Google Cloud : client OAuth de type "Application de bureau".
TASKFLOW_GOOGLE_CLIENT_ID=
# Facultatif pour certains clients Google Desktop ; ce secret n'est pas traité
# comme un secret fiable dans une application native distribuée.
TASKFLOW_GOOGLE_CLIENT_SECRET=
# Microsoft Entra : application publique "Mobile and desktop applications",
# redirect URI http://localhost, autorisations déléguées User.Read,
# Mail.ReadWrite et Mail.Send.
TASKFLOW_MICROSOFT_CLIENT_ID=
